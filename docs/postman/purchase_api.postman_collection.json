{
  "info": {
    "name": "Cytech EC Purchase API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "STEP11。Postman実機確認は未実施。READMEの手順でデータと期限付きBearerトークンを用意してください。"
  },
  "item": [
    {
      "name": "201 購入成功",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"quantity\": 1}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{base_url}}/api/products/{{product_id}}/purchases",
        "description": "201は在庫を1減らします。実行前にREADMEの前提データを確認してください。"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"JSON response\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"));",
              "const data = pm.response.json().data;",
              "pm.test(\"purchase contract\", () => { pm.expect(data.id).to.be.a(\"number\"); pm.expect(data.product_id).to.eql(Number(pm.environment.get(\"product_id\"))); pm.expect(data.quantity).to.eql(1); pm.expect(data.remaining_stock).to.be.at.least(0); });",
              "pm.environment.set(\"last_sale_id\", data.id);"
            ]
          }
        }
      ]
    },
